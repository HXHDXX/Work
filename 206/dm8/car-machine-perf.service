[Unit]
Description=Car machine: high-performance no-suspend policy (206)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c "for c in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do echo performance > $c; done; for h in /sys/class/scsi_host/host*/link_power_management_policy; do echo max_performance > $h; done"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
